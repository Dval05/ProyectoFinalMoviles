@startuml Paquetes_Clean_Architecture
skinparam dpi 300
top to bottom direction
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60
title Diagrama de Paquetes — Clean Architecture (Flutter App)
caption Organización simplificada de capas y dependencias en lib/

skinparam backgroundColor #FAFAFA
skinparam package {
    BackgroundColor<<presentation>> #BBDEFB
    BackgroundColor<<domain>> #C8E6C9
    BackgroundColor<<data>> #FFE0B2
    BackgroundColor<<core>> #E1BEE7
}

package "lib/" {
    package "presentation/" <<presentation>> {
        [views/] as P_VIEWS
        [viewmodels/] as P_VM
        [widgets/] as P_WIDGETS
        [routes/] as P_ROUTES
        
        P_VIEWS --> P_VM
        P_VIEWS --> P_WIDGETS
    }

    package "domain/" <<domain>> {
        [usecases/] as D_UC
        [repositories/ (interfaces)] as D_REPO
        [entities/] as D_ENT
        
        D_UC --> D_REPO
        D_UC --> D_ENT
        D_REPO --> D_ENT
    }

    package "data/" <<data>> {
        [repositories/ (impl)] as DA_REPO
        [datasources/] as DA_DS
        [models/] as DA_MODELS
        
        DA_REPO --> DA_DS
        DA_REPO --> DA_MODELS
    }

    package "core/" <<core>> {
        [services/] as C_SERV
        [utils/ & constants/] as C_UTIL
    }

    [main.dart] as MAIN
    [injection_container.dart] as DI
}

' === Dependencias principales entre capas ===
P_VM ..> D_UC : "Llama a Casos de Uso"
DA_REPO ..|> D_REPO : "Implementa Interfaces"
DA_MODELS ..> D_ENT : "Se mapea a Entidades"

presentation ..> core
data ..> core
domain ..> core

MAIN --> DI
DI --> presentation
DI --> domain
DI --> data

note bottom of "domain/"
  **Regla de Dependencia:**
  Esta capa NO depende de Flutter,
  Firebase ni librerías externas.
end note

@enduml
